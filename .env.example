# Leave these empty to run fully offline: recipes are then saved in the
# browser (localStorage) on top of the bundled sample recipes.
#
# Fill them in to store recipes in Supabase instead (see supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=recipe-images
